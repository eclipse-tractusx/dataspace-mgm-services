# Settings of the Community Days stack. Copy to `.env` and change only what you need; without `.env` the
# values below are the defaults. Test values only: nothing here is a real secret.

# Port of the portal in the browser. Keycloak accepts only 3000 or 8081 as return address (client portal-ui),
# so use one of these two.
PORTAL_PORT=3000
# Address of the portal in the browser; follows PORTAL_PORT. Set it only when the host port differs from the
# address the browser uses (e.g. a port forward).
# PORTAL_URL=http://localhost:3000

# Host port of Keycloak. The test realm expects http://localhost:8080 (sign-in through the EBW-Connector
# stand-in), so a browser sign-in works only with 8080.
KEYCLOAK_PORT=8080
KEYCLOAK_VERSION=26.8.1
# Admin of Keycloak (http://localhost:8080/auth/admin, user `admin`). Takes effect only on the first start
# of an empty Keycloak volume.
KEYCLOAK_ADMIN_PASSWORD=admin-test-only

# Superuser of PostgreSQL (not published to the host). Takes effect only on the first start of an empty volume.
# The roles of the features have the fixed test passwords of deploy/postgres/init-feature-databases.sql.
POSTGRES_PASSWORD=postgres-test-only

# Test tools of the backend (EBW-Connector and provider system doubles, POST /scaffold/reset). See README.md.
TEST_TOOLS=true

# Checkouts, relative to this folder
UI_PATH=../../../dataspace-mgm-ui
SPEC_PATH=../../spec

# Name of the Compose project (containers and volumes are named after it)
# COMPOSE_PROJECT_NAME=community-days
